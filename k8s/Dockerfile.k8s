FROM vllm/vllm-openai:v0.10.2

# =============================================================================
# DeepSWE K8s Training Image (DinD + GPU Training)
# Base: vllm/vllm-openai:v0.10.2 (includes torch, cuda, vllm 0.10.2)
#
# rllm source is mounted at runtime via hostPath, not baked into image.
# DinD (Docker-in-Docker) for R2E-Gym SWE task containers.
#
# Build (from rllm repo root):
#   docker build --network=host \
#     --build-arg http_proxy=http://127.0.0.1:1083 \
#     --build-arg https_proxy=http://127.0.0.1:1083 \
#     -t rllm-deepswe:latest -f k8s/Dockerfile.k8s .
# =============================================================================

# Override vllm's default entrypoint (api_server)
ENTRYPOINT ["/bin/bash"]

# ---------- pip mirrors (Chinese mirrors for faster downloads) ----------
RUN mkdir -p /root/.pip && \
    printf '[global]\ntimeout = 300\nindex-url = http://pypi.tuna.tsinghua.edu.cn/simple/\nextra-index-url = http://pypi.mirrors.ustc.edu.cn/simple/\n                  http://repo.huaweicloud.com/repository/pypi/simple\n\n[install]\ntrusted-host = pypi.tuna.tsinghua.edu.cn\n               pypi.mirrors.ustc.edu.cn\n               repo.huaweicloud.com\n' > /root/.pip/pip.conf

# ---------- System deps + Docker CE for DinD ----------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git wget curl vim htop rsync openssh-client \
        ca-certificates gnupg lsb-release iptables kmod procps iproute2 && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | \
        gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
        https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" \
        > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        docker-ce docker-ce-cli containerd.io && \
    rm -rf /var/lib/apt/lists/*

# ---------- Python deps ----------
# verl (RL training framework)
RUN pip install --no-cache-dir "verl==0.6.1" "verl[vllm]"

# Ray for multi-node cluster
RUN pip install --no-cache-dir "ray[default]>=2.40"

# R2E-Gym (SWE-Bench environment)
RUN pip install --no-cache-dir --ignore-installed blinker && \
    pip install --no-cache-dir git+https://github.com/agentica-project/R2E-Gym

# PPIO Sandbox SDK
RUN pip install --no-cache-dir ppio_sandbox

# rllm core dependencies + swe extras (rllm itself mounted at runtime)
RUN pip install --no-cache-dir \
    transformers>=4.55.0 \
    datasets>=2.20.0 \
    pandas polars pillow numpy sympy \
    pylatexenc "antlr4-python3-runtime==4.9.3" \
    mcp eval-protocol \
    hydra-core openai fastapi uvicorn \
    tqdm PyYAML pydantic wrapt "asgiref>=3.7.0" wandb \
    docker kubernetes swebench

# Megatron backend (EP/TP for MoE training)
# Install TE cu12 binary first, then meta package, then torch wrapper (needs cudnn.h)
RUN pip install --no-cache-dir megatron-core==0.16.0 mbridge==0.15.1 \
        transformer-engine-cu12==2.12.0 transformer-engine==2.12.0 && \
    CUDNN_INC=$(python3 -c "from pathlib import Path; import nvidia.cudnn; print(Path(nvidia.cudnn.__path__[0])/'include')") && \
    CUDNN_LIB=$(python3 -c "from pathlib import Path; import nvidia.cudnn; print(Path(nvidia.cudnn.__path__[0])/'lib')") && \
    MAX_JOBS=$(nproc) \
    CPLUS_INCLUDE_PATH="${CUDNN_INC}" C_INCLUDE_PATH="${CUDNN_INC}" LIBRARY_PATH="${CUDNN_LIB}" \
    pip install --no-cache-dir --no-build-isolation transformer-engine-torch==2.12.0

# Flash Attention 2 (required for FSDP training with Qwen3)
RUN pip install --no-cache-dir flash-attn --no-build-isolation && \
    pip install --no-cache-dir "numpy<2.3"

# Playwright (for web-based agent tasks)
RUN pip install --no-cache-dir playwright && \
    playwright install chromium && \
    playwright install-deps

# ---------- Patch verl for megatron-core 0.16 API + JSON extra_info ----------
COPY k8s/scripts/patch_optimizer.py /tmp/patch_optimizer.py
RUN python3 /tmp/patch_optimizer.py && rm /tmp/patch_optimizer.py && \
    python3 -c "\
import verl.utils.dataset.rl_dataset as m; \
fpath = m.__file__; \
content = open(fpath).read(); \
assert 'json.loads' not in content, 'already patched'; \
content = content.replace('import copy\n', 'import copy\nimport json\n', 1); \
old = '        if \"extra_info\" not in row_dict or row_dict[\"extra_info\"] is None:\n            row_dict[\"extra_info\"] = dict()'; \
new = old + '\n        elif isinstance(row_dict[\"extra_info\"], str):\n            row_dict[\"extra_info\"] = json.loads(row_dict[\"extra_info\"])'; \
content = content.replace(old, new); \
open(fpath, 'w').write(content); \
print('Patched verl rl_dataset.py')"

# ---------- Env defaults ----------
ENV NCCL_CUMEM_ENABLE=0
ENV NCCL_DEBUG=WARN
ENV TORCH_NCCL_ASYNC_ERROR_HANDLING=1
ENV VLLM_USE_V1=1
ENV VLLM_ATTENTION_BACKEND=FLASH_ATTN
ENV FLASHINFER_DISABLE_VERSION_CHECK=1

# ---------- Entrypoint + helper scripts ----------
COPY k8s/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY k8s/scripts/prewarm-images.py /usr/local/bin/prewarm-images.py
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
